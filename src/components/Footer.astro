---
import Logo from './Logo.astro';
import site from '../data/site.json';

const year = new Date().getFullYear();
const { email, instagram, tiktok } = site.contact;

const links = [
  { href: '/#kako-radimo', label: 'Kako radimo' },
  { href: '/#cijene', label: 'Cijene' },
  { href: '/o-nama', label: 'O nama' },
  { href: '/blog', label: 'Blog' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<footer class="footer band band--forest tone-dark">
  <div class="container">
    <div class="footer__top">
      <a href="/" class="footer__home" aria-label="Nulta točka, početna">
        <Logo />
      </a>
      <nav aria-label="Podnožje">
        <ul class="footer__links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
          {email && (
            <li>
              <a href={`mailto:${email}`}>{email}</a>
            </li>
          )}
          <li>
            <a href={instagram} rel="noopener" target="_blank">Instagram</a>
          </li>
          {tiktok && (
            <li>
              <a href={tiktok} rel="noopener" target="_blank">TikTok</a>
            </li>
          )}
        </ul>
      </nav>
    </div>

    <div class="legal">
      <p>
        Nulta točka nije psihološka, psihijatrijska niti zdravstvena ustanova. Ne postavljamo dijagnoze
        niti provodimo terapijske tretmane. Pružamo mentorstvo, podršku i usmjeravanje. Ako procijenimo
        da je potrebna stručna pomoć, uputit ćemo te odgovarajućim stručnjacima.
      </p>
      <p class="legal__meta">
        <span>© {year} Nulta točka</span>
        <a href="/privatnost">Privatnost</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .footer a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  .footer a:hover {
    color: var(--color-accent);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg) var(--space-xl);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  /* dovoljno velika površina za prst, bez većeg izgleda */
  .footer__links a {
    display: inline-block;
    padding-block: var(--space-xs);
  }

  @media (max-width: 40rem) {
    .footer__links {
      column-gap: var(--space-lg);
      row-gap: 0;
    }
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .legal p:first-child {
    max-width: 80ch;
  }

  .legal__meta {
    display: flex;
    gap: var(--space-lg);
    white-space: nowrap;
  }

  .legal__meta a {
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
