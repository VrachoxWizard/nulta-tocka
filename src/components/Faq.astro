---
import site from '../data/site.json';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: site.faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section class="section band band--mint faq" id="pitanja">
  <div class="container grid12">
    <div class="faq__head">
      <h2>Prije nego što se javiš</h2>
      <p class="faq__more">
        Nema tvog pitanja? <a href="/kontakt" class="link">Piši nam</a>
      </p>
    </div>

    <div class="faq__list">
      {
        site.faq.map((f) => (
          <details class="faq__item" name="faq">
            <summary>
              <span>{f.question}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{f.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq__head {
    grid-column: 1 / span 4;
    align-self: start;
    position: sticky;
    top: var(--space-3xl);
  }

  .faq__more {
    margin-top: var(--space-lg);
    color: var(--color-ink-2);
  }

  .faq__list {
    grid-column: 6 / -1;
    border-top: var(--rule-hair) solid var(--color-ink);
  }

  .faq__head h2 {
    max-width: 12ch;
  }

  .faq__item {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 72px;
    padding-block: var(--space-md);
    cursor: pointer;
    list-style: none;
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--color-accent);
  }

  summary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    translate: -50% -50%;
    transition: transform var(--dur-short) var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  details[open] summary {
    color: var(--color-accent);
  }

  /* glatko otvaranje gdje preglednik to zna; drugdje se odgovor samo pojavi */
  .faq__item {
    interpolate-size: allow-keywords;
  }

  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-long) var(--ease-out),
      content-visibility var(--dur-long) allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  .faq__item p {
    padding-bottom: var(--space-lg);
    max-width: 62ch;
    padding-right: var(--space-2xl);
    color: var(--color-ink-2);
  }

  @media (max-width: 60rem) {
    .faq__head,
    .faq__list {
      grid-column: 1 / -1;
    }

    .faq__head {
      position: static;
      margin-bottom: var(--space-xl);
    }
  }
</style>
