---
import site from '../data/site.json';

const href = (calEvent: string) => (calEvent ? `/rezervacija?usluga=${calEvent}` : '/kontakt');
---

<section class="section prices" id="cijene">
  <div class="container">
    <div class="prices__head">
      <h2>Ti biraš koliko podrške ti treba.</h2>
      <p class="lead">Kreni s uvodnim razgovorom pa zajedno odlučimo što ima smisla dalje.</p>
    </div>

    <ul class="plans">
      {
        site.pricing.map((plan, i) => (
          <li class:list={['plan', { 'plan--first tone-dark': i === 0 }]}>
            <div>
              <h3 class="plan__title">{plan.title}</h3>
              {plan.highlight && <p class="plan__tag">najčešći izbor</p>}
            </div>
            <p class="plan__price num">
              {plan.price}
              {plan.period && <span>{plan.period}</span>}
            </p>
            <ul class="plan__features">
              {plan.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <div class="plan__act">
              {/* puni gumb nosi prvi korak (uvodni razgovor), ostali su obrubljeni */}
              <a href={href(plan.calEvent)} class={i === 0 ? 'btn' : 'btn btn--quiet'}>
                {plan.cta}
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="prices__note">{site.booking.paymentNote}</p>
  </div>
</section>

<style>
  .prices__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    align-items: end;
  }

  .prices__head h2 {
    grid-column: 1 / span 6;
  }

  .prices__head .lead {
    grid-column: 8 / -1;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }

  /* subgrid drži cijene, popise i akcije u istoj liniji u sva tri stupca */
  .plan {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-tile);
  }

  /* prvi korak je cilj stranice: tamna jela kartica sa žutim gumbom */
  .plan--first {
    border-color: transparent;
    background: var(--color-forest);
  }

  .plan__title {
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .plan__tag {
    display: inline-block;
    margin-top: var(--space-xs);
    padding: var(--space-3xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-highlight);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ref-ink);
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-display-s);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .plan__price span {
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .plan__features {
    margin: var(--space-lg) 0 0;
    padding: var(--space-md) 0 0;
    list-style: none;
    border-top: var(--rule-hair) solid var(--color-rule);
    color: var(--color-ink-2);
  }

  .plan__features li + li {
    margin-top: var(--space-xs);
  }

  .plan__act {
    align-self: end;
    margin-top: var(--space-xl);
  }

  .prices__note {
    margin-top: var(--space-xl);
    color: var(--color-ink-2);
  }

  @media (max-width: 60rem) {
    .prices__head h2,
    .prices__head .lead {
      grid-column: 1 / -1;
    }

    .prices__head .lead {
      margin-top: var(--space-md);
    }

    .plans {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-md);
      margin-top: var(--space-2xl);
    }

    .plan {
      display: block;
      padding: var(--space-lg);
    }

    .plan__act .btn {
      width: 100%;
    }
  }
</style>
