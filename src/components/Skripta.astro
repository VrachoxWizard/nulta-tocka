---
import Logo from './Logo.astro';

const stages = [
  { title: 'Upoznavanje', text: 'Pričaš svojim tempom, koliko želiš.' },
  { title: 'Razumijevanje', text: 'Tražimo obrasce i ono što te koči.' },
  { title: 'Plan za dalje', text: 'Dobivaš skriptu s konkretnim koracima.' },
  { title: 'Praćenje', text: 'Ako želiš, nastavljamo redovitim razgovorima.' },
];

const contents = [
  'kako smo razumjeli tvoju situaciju',
  'obrasci ponašanja, misli i reakcija',
  'snage i resursi koje već imaš',
  'mogući uzroci i okidači',
  'praktični koraci za svakodnevicu',
  'preporuke do idućeg susreta',
  'vježbe samopromatranja i nošenja sa stresom',
  'tvoji ciljevi i smjernice za napredak',
];
---

<section class="section band band--forest tone-dark skripta" id="kako-radimo">
  <div class="container grid12 skripta__grid">
    <div class="skripta__text">
      <h2>Ne završava sve razgovorom.</h2>
      <p class="lead skripta__lead">
        Nakon razgovora dobivaš osobnu skriptu, dokument u kojem je sažeto sve što smo zajedno
        prepoznali.
      </p>

      <ol class="steps">
        {
          stages.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <figure class="sheet">
      <div class="sheet__page tone-light">
        <div class="sheet__meta" aria-hidden="true">
          <Logo />
          <span>za tebe</span>
        </div>
        <p class="sheet__title">Osobna skripta</p>
        <ol class="sheet__toc">
          {/* jedna stavka podcrtana markerom, kao radni dokument */}
          {contents.map((c, i) => <li>{i === 4 ? <mark>{c}</mark> : c}</li>)}
        </ol>
      </div>
      <figcaption>Primjer sadržaja skripte. Ono što u njoj piše uvijek je samo tvoje.</figcaption>
    </figure>
  </div>
</section>

<style>
  .skripta__grid {
    align-items: start;
    row-gap: var(--space-2xl);
  }

  .skripta__text {
    grid-column: 1 / span 6;
  }

  .skripta__lead {
    margin-top: var(--space-lg);
  }


  .sheet {
    grid-column: 8 / -1;
    margin: 0;
  }

  /* osobna skripta stoji uspravno, kao list papira na stolu */
  .sheet__page {
    padding: var(--space-xl);
    background: var(--color-paper-3);
    border-radius: var(--radius-photo);
  }

  .sheet__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .sheet__meta :global(.wordmark) {
    color: var(--color-ink);
    transform: scale(0.82);
    transform-origin: left center;
  }

  .sheet__toc mark {
    padding: 0 0.15em;
    margin: 0 -0.15em;
    background: linear-gradient(transparent 52%, var(--color-highlight) 52%, var(--color-highlight) 92%, transparent 92%);
    color: inherit;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .sheet__title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-accent);
  }

  .sheet__toc {
    margin: var(--space-md) 0 0;
    padding-left: var(--space-lg);
  }

  .sheet__toc li {
    padding: var(--space-sm) 0 var(--space-sm) var(--space-2xs);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .sheet__toc li:last-child {
    border-bottom: 0;
  }

  .sheet__toc li::marker {
    color: var(--color-accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .sheet figcaption {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (max-width: 60rem) {
    .skripta__text,
    .sheet {
      grid-column: 1 / -1;
    }

    .sheet__page {
      padding: var(--space-lg);
    }
  }
</style>
