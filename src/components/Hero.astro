---
import { Image } from 'astro:assets';
// Fotografija: Brunxs Monochrome, Unsplash (unsplash.com/photos/K0bc15BCR8k), Unsplash licenca.
import photo from '../assets/hero.jpg';

// riječi naslova izlaze jedna za drugom dok svjetlo sviće; „rađa se“ ostaje zajedno
const words = ['Na', 'granici', 'gdje', 'etikete', 'utihnu,', 'rađa se', 'poimanje.'];
---

<section class="hero band band--forest tone-dark dawn">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 class="hero__head">
        {
          words.map((w, i) => (
            <>
              <span class="hero__w" style={`--i: ${i}`}>{w}</span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }
      </h1>
      <p class="lead hero__lead">
        Mentorstvo i podrška za osobni razvoj, kroz razgovor bez osuđivanja.
      </p>
      <div class="hero__actions">
        <a href="/rezervacija" class="btn">Rezerviraj uvodni razgovor</a>
        <p class="hero__terms">45 minuta, online, 10 €</p>
      </div>
    </div>

    <figure class="hero__photo photo">
      <Image
        src={photo}
        alt="Prazna fotelja uz prozor kroz koji ulazi jutarnje svjetlo"
        widths={[480, 720, 1080]}
        sizes="(max-width: 60rem) 100vw, 34vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-3xl);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    align-items: center;
    min-height: min(calc(100svh - 73px - 2 * var(--space-3xl)), 46rem);
  }

  .hero__text {
    grid-column: 1 / span 7;
  }

  .hero__head {
    max-width: 14ch;
    font-size: clamp(2.875rem, 5.2vw + 0.75rem, 6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .hero__lead {
    margin-top: var(--space-xl);
    max-width: 32ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-xl);
  }

  .hero__terms {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* fotografija ispunjava visinu prvog ekrana uz desni rub */
  .hero__photo {
    grid-column: 8 / -1;
    position: relative;
    align-self: stretch;
    min-height: 28rem;
    margin: 0;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 60%;
  }

  .hero__w {
    display: inline-block;
  }

  /* Svitanje: svjetlo (.dawn) kreće odmah, riječi se rađaju jedna za drugom,
     fotografija se polako razdani, a lead i gumb dolaze kad je naslov cijeli */
  @media (prefers-reduced-motion: no-preference) {
    .hero__w {
      animation: rise 0.8s var(--ease-out) both;
      animation-delay: calc(250ms + var(--i) * 75ms);
    }

    .hero__lead,
    .hero__actions {
      animation: settle 0.7s var(--ease-out) both;
    }

    .hero__lead {
      animation-delay: 850ms;
    }

    .hero__actions {
      animation-delay: 950ms;
    }

    .hero__photo {
      animation: settle 0.9s var(--ease-out) 150ms both;
    }

    .hero__img {
      animation: wake 2.8s var(--ease-out) both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0.001;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes settle {
    from {
      opacity: 0.001;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes wake {
    from {
      filter: grayscale(1) brightness(0.72);
    }
    to {
      filter: grayscale(1) brightness(1);
    }
  }

  @media (max-width: 60rem) {
    .hero {
      padding-block: var(--space-2xl);
    }

    .hero__grid {
      min-height: 0;
      row-gap: var(--space-xl);
    }

    .hero__text,
    .hero__photo {
      grid-column: 1 / -1;
    }

    .hero__lead {
      margin-top: var(--space-lg);
    }

    .hero__photo {
      min-height: 0;
    }

    .hero__img {
      position: static;
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
