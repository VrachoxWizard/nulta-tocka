---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Close from '../../components/Close.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} type="article">
  <PageHeader
    title={post.data.title}
    lead={post.data.description}
    back={{ href: '/blog', label: 'Svi članci' }}
  >
    <p class="article__meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span>{readingTime(post.body)} min čitanja</span>
    </p>
  </PageHeader>

  <article class="section article">
    <div class="container grid12">
      <div class="prose article__body">
        <Content />
      </div>
      <p class="article__end">
        <a href="/blog" class="link">Svi članci</a>
      </p>
    </div>
  </article>
  <Close />
</Base>

<style>
  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-lg);
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .article__body,
  .article__end {
    grid-column: 3 / span 8;
  }

  .article__end {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  @media (max-width: 60rem) {
    .article__body,
    .article__end {
      grid-column: 1 / -1;
    }
  }
</style>
