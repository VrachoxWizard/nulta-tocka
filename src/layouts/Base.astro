---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  showStickyCta?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-image.png',
  type = 'website',
  showStickyCta = true,
} = Astro.props;

const fullTitle = title ? `${title} | Nulta točka` : 'Nulta točka | Mentorstvo i podrška za osobni razvoj';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  description: site.description,
  slogan: site.tagline,
  areaServed: 'HR',
  sameAs: [site.contact.instagram, site.contact.tiktok].filter(Boolean),
  makesOffer: site.pricing.map((p) => ({
    '@type': 'Offer',
    name: p.title,
    description: p.summary,
    priceCurrency: 'EUR',
    price: p.price.replace(/[^\d]/g, ''),
  })),
};
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FFFFFF" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:site_name" content="Nulta točka" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Preskoči na sadržaj</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {showStickyCta && <StickyCta />}
  </body>
</html>

<style is:global>
  /* ponovljeno iz base.css da ga vidi i statička provjera layouta */
  html,
  body {
    overflow-x: clip;
  }

  /* footer uvijek na dnu, i na kratkim stranicama na visokim ekranima */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  main {
    flex: 1;
  }
</style>
